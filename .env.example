# Server configuration (ADR 0001). The browser demo remains local-only.
# Copy to a private .env for maintenance commands; never commit real values.
# Used by DB maintenance and server flows; never NEXT_PUBLIC_.
# Leave false until migrations, mail worker and provider configuration are ready.
FIRST_PRESS_AUTH_ENABLED=false
DATABASE_URL=postgresql://first_press:CHANGE_ME@127.0.0.1:5432/first_press
BETTER_AUTH_URL=http://127.0.0.1:3000
# Generate a separate strong secret of at least 32 characters per environment.
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# SMTP credentials belong to the mail worker, which requires verified TLS.
# A relay/provider must be configured and delivery tested before live access.
AUTH_EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Local compose.db.yaml only; use a distinct strong password.
POSTGRES_PASSWORD=CHANGE_ME
# Only disposable CI/local test DBs, never application DATABASE_URL.
TEST_DATABASE_URL=postgresql://first_press:CHANGE_ME@127.0.0.1:5432/first_press_test
# Demo seeding also requires a separate database name ending _demo.
ALLOW_DEMO_SEED=false

# Optional: only set a client IP header that a private reverse proxy overwrites.
# Empty uses a shared auth rate-limit bucket; never trust arbitrary forwarded headers.
AUTH_TRUSTED_IP_HEADER=
