# Server configuration (ADR 0001). The browser demo remains local-only.
# Copy to a private .env for maintenance commands; never commit real values.
# Used by DB maintenance and future server flows; never NEXT_PUBLIC_.
DATABASE_URL=postgresql://first_press:CHANGE_ME@127.0.0.1:5432/first_press
BETTER_AUTH_URL=http://127.0.0.1:3000
# Generate a separate strong secret per environment when implementing auth.
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Server-side mail transport; relay/provider selection and integration are pending.
AUTH_EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Local compose.db.yaml only; use a distinct strong password.
POSTGRES_PASSWORD=CHANGE_ME
# Only disposable CI/local test DBs, never application DATABASE_URL.
TEST_DATABASE_URL=postgresql://first_press:CHANGE_ME@127.0.0.1:5432/first_press_test
# Demo seeding also requires a separate database name ending _demo.
ALLOW_DEMO_SEED=false
